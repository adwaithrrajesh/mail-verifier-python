# Example environment file for mailscout-email-finder
# Copy this file to .env and fill in the values.

# Required: shared secret for internal JWT between services
INTERNAL_JWT_SECRET=CHANGE_ME_TO_A_STRONG_RANDOM_VALUE

# Optional performance tuning (have safe defaults in code / compose)
#SMTP_TIMEOUT=2
#NUM_THREADS=100
#NUM_BULK_THREADS=50
#BATCH_SIZE=100
#CONNECTION_POOL_SIZE=100
#MAX_RETRIES=1
#RETRY_DELAY=0.5
